layout {
   default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Espx-LS" cwd="~/Documents/projects/espx-ls" 
    tab name="Espx-LS NV" cwd="~/Documents/projects/espx-ls" 
    tab name="Testing" cwd="~/Documents/projects/espx-ls/testing" 
    tab name="Espionox" cwd="~/Documents/projects/espionox" 
    tab name="Espionox NV" cwd="~/Documents/projects/espionox" 
}

